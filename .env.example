OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
CHROMA_DB_PATH=./chroma_db

JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Shared secret the frontend sends as the X-Admin-Api-Key header.
# Must match ADMIN_API_KEY in frontend/.env. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Self-hosted Langfuse (only used by `docker compose up`) ---
# These LANGFUSE_INIT_* vars auto-provision an org/project/admin user on
# langfuse-web's first boot - no manual sign-up or UI setup needed.
# docker-compose.yml passes LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY
# straight through to the backend's LANGFUSE_PUBLIC_KEY/SECRET_KEY, so
# they only need to be set once, here.
#
# IMPORTANT: these vars only make sense inside the Docker network
# (LANGFUSE_HOST there is http://langfuse-web:3000). If you ever add
# LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY directly to this file for local
# (non-Docker) dev, tracing will try to reach that hostname and hang -
# leave them out of local dev entirely.
LANGFUSE_INIT_ORG_ID=agent-hub-org
LANGFUSE_INIT_ORG_NAME=Agent Hub
LANGFUSE_INIT_PROJECT_ID=agent-hub
LANGFUSE_INIT_PROJECT_NAME=Agent Hub
# Generate with: python3 -c "import secrets; print('pk-lf-' + secrets.token_hex(16))"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# Generate with: python3 -c "import secrets; print('sk-lf-' + secrets.token_hex(16))"
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
LANGFUSE_INIT_USER_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEXTAUTH_SECRET=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
SALT=
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
