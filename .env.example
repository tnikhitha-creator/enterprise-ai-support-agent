OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
CHROMA_DB_PATH=./chroma_db

JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Shared secret the frontend sends as the X-Admin-Api-Key header.
# Must match ADMIN_API_KEY in frontend/.env. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
